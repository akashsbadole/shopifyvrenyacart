{% layout 'password' %}

<div class="min-h-screen flex items-center justify-center bg-[var(--color-background)] px-6">
  <div class="max-w-md w-full text-center">
    {% if settings.logo != blank %}
      <div class="mb-8">
        {% capture logo_size %}{{ settings.logo_width | default: 150 }}{% endcapture %}
        <a href="{{ routes.root_url }}" class="inline-block">
          <img
            src="{{ settings.logo | image_url: width: logo_size }}"
            alt="{{ shop.name | escape }}"
            width="{{ logo_size }}"
            height="{{ settings.logo.height | divided_by: settings.logo.width | times: logo_size }}"
            Loading="lazy"
          >
        </a>
      </div>
    {% else %}
      <h1 class="text-3xl font-bold tracking-tight mb-2">{{ shop.name | escape }}</h1>
    {% endif %}

    <div class="prose prose-sm mb-8">
      {% if shop.password_message != blank %}
        {{ shop.password_message }}
      {% else %}
        <p>We'll be open soon. Sign up to get notified when we launch.</p>
      {% endif %}
    </div>

    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">

      {% if form.posted_successfully? %}
        <div class="rounded p-4 mb-4 bg-[var(--color-success)]/10 text-[var(--color-success)]">
          <p>Thanks for subscribing! We'll notify you when we launch.</p>
        </div>
      {% else %}
        {% if form.errors %}
          <div class="rounded p-4 mb-4 bg-[var(--color-error)]/10 text-[var(--color-error)]">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="flex flex-col sm:flex-row gap-3">
          <label for="Email" class="sr-only">Email</label>
          <input
            type="email"
            name="contact[email]"
            id="Email"
            required
            placeholder="{{ 'general.newsletter.email_label' | t }}"
            class="flex-1 h-12 px-4 border border-[var(--color-border)] rounded bg-[var(--color-surface)] focus:outline-none focus:border-[var(--color-primary)] focus:ring-1 focus:ring-[var(--color-primary)]"
          >
          <button
            type="submit"
            class="h-12 px-6 bg-[var(--color-primary)] text-[var(--color-text-inverse)] font-semibold rounded hover:opacity-90 transition-opacity"
          >
            {{ 'general.newsletter.subscribe_button' | t }}
          </button>
        </div>
      {% endif %}
    {% endform %}

    {% if shop.password_production_time != blank or shop.password_link != blank %}
      <div class="mt-6 pt-6 border-t border-[var(--color-border-subtle)]">
        {% if shop.password_production_time != blank %}
          <p class="text-sm text-[var(--color-text-secondary)]">
            Opening: {{ shop.password_production_time }}
          </p>
        {% endif %}

        {% if shop.password_link != blank %}
          <a href="{{ shop.password_link }}" class="inline-block mt-2 text-sm underline hover:opacity-70">
            {{ shop.password_link_title | default: 'Enter using password' }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% render 'social-icons' %}
  </div>
</div>