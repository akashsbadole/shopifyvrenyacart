<!doctype html>
<html class="{{ request.body_html_class }}" lang="{{ request.locale }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0052FF">
  <link rel="canonical" href="{{ canonical_url }}">
  
  {% comment %}Preconnect to external resources{% endcomment %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdn.tailwindcss.com">
  
  {% comment %}SEO Meta Tags{% endcomment %}
  {% if template == 'product' %}
    <meta name="robots" content="index, follow">
  {% elsif template == 'article' %}
    <meta name="robots" content="index, follow">
  {% else %}
    <meta name="robots" content="index, follow">
  {% endif %}

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {% comment %}Open Graph{% endcomment %}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:description" content="{{ page_description | escape | default: shop.description }}">
  {% if template == 'product' and product.featured_media %}
    <meta property="og:image" content="https:{{ product.featured_media | image_url: width: 1200 }}">
  {% endif %}

  {% comment %}Twitter Card{% endcomment %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | escape }}">
  <meta name="twitter:description" content="{{ page_description | escape | default: shop.description }}">

  {% render 'favicon' %}

  <title>{{ page_title | escape }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}</title>

  {% render 'social-meta-tags' %}
  {% render 'seo-schema' %}

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            'primary': '#0052FF',
            'primary-container': '#0052FF',
            'on-primary': '#ffffff',
            'background': '#fbf9f9',
            'surface': '#fbf9f9',
            'surface-container-low': '#f5f3f3',
            'surface-container-lowest': '#ffffff',
            'surface-container': '#efeded',
            'on-background': '#18181b',
            'on-surface': '#18181b',
            'on-surface-variant': '#71717a',
            'outline': '#737688',
            'outline-variant': '#c3c5d9',
            'error': '#ba1a1a',
            'secondary': '#5f5e5e',
          },
          fontFamily: {
            'display': ['Plus Jakarta Sans', 'sans-serif'],
            'body': ['Plus Jakarta Sans', 'sans-serif'],
          },
          fontSize: {
            'display': ['64px', { lineHeight: '1.1', letterSpacing: '-0.02em', fontWeight: '700' }],
            'h1': ['40px', { lineHeight: '1.2', letterSpacing: '-0.01em', fontWeight: '700' }],
            'h2': ['32px', { lineHeight: '1.3', letterSpacing: '-0.01em', fontWeight: '600' }],
            'h3': ['24px', { lineHeight: '1.4', fontWeight: '600' }],
            'body-md': ['16px', { lineHeight: '1.6', fontWeight: '400' }],
            'body-lg': ['18px', { lineHeight: '1.6', fontWeight: '400' }],
            'label-bold': ['14px', { lineHeight: '1', letterSpacing: '0.05em', fontWeight: '700' }],
            'price': ['20px', { lineHeight: '1', fontWeight: '700' }],
          },
          spacing: {
            'section-padding': '120px',
            'container-max': '1440px',
            'gutter': '32px',
          },
          borderRadius: {
            'DEFAULT': '4px',
          }
        }
      }
    }
  </script>

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    if (window.Shopify && window.Shopify.designMode) {
      document.documentElement.className += ' in-theme-editor';
    }
  </script>

  {{ content_for_header }}

  {% style %}
    :root {
      --color-primary: {{ settings.color_primary }};
      --color-primary-hover: {{ settings.color_primary_hover }};
      --color-background: {{ settings.color_background }};
      --color-surface: {{ settings.color_surface }};
      --color-surface-elevated: {{ settings.color_surface_elevated }};
      --color-text-primary: {{ settings.color_text_primary }};
      --color-text-secondary: {{ settings.color_text_secondary }};
      --color-text-inverse: {{ settings.color_text_inverse }};
      --color-border: {{ settings.color_border }};
      --color-border-subtle: {{ settings.color_border_subtle }};
      --color-error: {{ settings.color_error }};
      --color-success: {{ settings.color_success }};
      --color-warning: {{ settings.color_warning }};
      --color-sale: {{ settings.color_sale }};

      --font-heading: {{ settings.font_heading }};
      --font-body: {{ settings.font_body }};

      --container-width: 1440px;
      --section-spacing: 80px;
      --grid-gutter: 32px;
      --border-radius: 4px;
    }
  {% endstyle %}
</head>

<body class="bg-[#fbf9f9] text-[#18181b] font-['Plus_Jakarta_Sans'] antialiased{% if template == 'customers/account' or template == 'customers/order' %} account-page{% endif %}">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 bg-white px-4 py-2 rounded">
    Skip to content
  </a>

  {% section 'header' %}

  <main id="main-content" role="main" tabindex="-1" aria-label="Main content">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}
  {% section 'cart-drawer' %}
  
  {% comment %}Back to top button{% endcomment %}
  <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" 
          id="back-to-top"
          class="fixed bottom-8 right-8 w-12 h-12 bg-[#0052FF] text-white rounded-full shadow-lg flex items-center justify-center opacity-0 invisible transition-all duration-300 hover:bg-[#0038b6] z-40"
          aria-label="Back to top">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
  </button>

  <script src="{{ 'theme.js' | asset_url }}" defer></script>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const backToTop = document.getElementById('back-to-top');
      window.addEventListener('scroll', function() {
        if (window.scrollY > 300) {
          backToTop.classList.remove('opacity-0', 'invisible');
          backToTop.classList.add('opacity-100', 'visible');
        } else {
          backToTop.classList.add('opacity-0', 'invisible');
          backToTop.classList.remove('opacity-100', 'visible');
        }
      });
    });
  </script>

  <noscript>
    <div class="fixed bottom-0 left-0 right-0 bg-[#0052FF] text-white px-4 py-3 text-center">
      Please enable JavaScript for the best experience.
    </div>
  </noscript>
</body>
</html>