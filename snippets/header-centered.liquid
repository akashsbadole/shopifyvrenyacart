{% comment %}Header Centered Style{% endcomment %}
<div class="header-centered">
  <a href="{{ routes.root_url }}" class="header__logo">
    {% if settings.logo != blank %}
      {% assign logo_height = settings.logo.width | divided_by: settings.logo.width | times: 50 %}
      <img src="{{ settings.logo | image_url: width: 150 }}" alt="{{ shop.name | escape }}" width="150" height="{{ logo_height }}">
    {% else %}
      {{ shop.name }}
    {% endif %}
  </a>
</div>