{% comment %}Social Meta Tags - Open Graph & Twitter Cards - LUXE Theme{% endcomment %}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:type" content="website">
<meta property="og:locale" content="{{ request.locale.iso_code }}">

{%- assign og_image = settings.logo | image_url: width: 1200 -%}

{% if template contains 'product' %}
  <meta property="og:title" content="{{ product.title | strip_html | escape }}">
  <meta property="og:description" content="{{ product.description | strip_html | truncate: 200 | escape }}">
  <meta property="og:type" content="product">
  {%- if product.featured_media -%}
  <meta property="og:image" content="https:{{ product.featured_media | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="1200">
  {%- endif -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | escape }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code | escape }}">
  <meta property="og:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
  <meta property="product:brand" content="{{ product.vendor | escape }}">
  
{% elsif template contains 'collection' %}
  <meta property="og:title" content="{{ collection.title | strip_html | escape }} - {{ shop.name }}">
  <meta property="og:description" content="{{ collection.description | strip_html | truncate: 200 | escape }}">
  <meta property="og:type" content="website">
  {%- if collection.image -%}
  <meta property="og:image" content="https:{{ collection.image | image_url: width: 1200 }}">
  {%- endif -%}
  
{% elsif template contains 'article' %}
  <meta property="og:title" content="{{ article.title | strip_html | escape }}">
  <meta property="og:description" content="{{ article.excerpt | strip_html | truncate: 200 | escape }}">
  <meta property="og:type" content="article">
  {%- if article.image -%}
  <meta property="og:image" content="https:{{ article.image | image_url: width: 1200 }}">
  {%- endif -%}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' }}">
  <meta property="article:author" content="{{ article.author }}">
  <meta property="article:section" content="{{ blog.title }}">
  
{% elsif template == 'index' %}
  <meta property="og:title" content="{{ page_title | escape }} - {{ shop.name }}">
  <meta property="og:description" content="{{ shop.description | escape }}">
  <meta property="og:image" content="{{ og_image }}">
  
{% else %}
  <meta property="og:title" content="{{ page_title | escape }} - {{ shop.name }}">
  <meta property="og:description" content="{{ shop.description | escape }}">
  <meta property="og:image" content="{{ og_image }}">
{% endif %}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="{{ shop.name }}">

{% if template contains 'product' %}
  <meta name="twitter:title" content="{{ product.title | strip_html | escape }}">
  <meta name="twitter:description" content="{{ product.description | strip_html | truncate: 200 | escape }}">
  {%- if product.featured_media -%}
  <meta name="twitter:image" content="https:{{ product.featured_media | image_url: width: 1200 }}">
  {%- endif -%}
{% else %}
  <meta name="twitter:title" content="{{ page_title | escape }} - {{ shop.name }}">
  <meta name="twitter:description" content="{{ shop.description | escape }}">
  <meta name="twitter:image" content="{{ og_image }}">
{% endif %}

<meta name="pinterest-rich-pin" content="true">