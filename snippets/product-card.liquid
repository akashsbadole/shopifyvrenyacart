{% comment %}Product Card Snippet - LUXE Theme{% endcomment %}

{%- assign product = product -%}

<div class="group flex flex-col relative">
  {%- if product.tags contains 'new' -%}
    <div class="absolute top-2 left-2 z-10">
      <span class="text-[10px] uppercase tracking-widest text-[#0052FF] font-bold">New</span>
    </div>
  {%- endif -%}
  
  <a href="{{ product.url }}" class="block">
    <div class="bg-white aspect-square p-4 mb-4 flex items-center justify-center border border-transparent group-hover:border-zinc-200 transition-colors overflow-hidden">
      {%- if product.featured_media != blank -%}
        {{ product.featured_media | image_url: width: 400 | image_tag: class: 'w-full h-full object-contain mix-blend-multiply group-hover:scale-105 transition-transform duration-500', loading: 'lazy' }}
      {%- else -%}
        <div class="w-full h-full flex items-center justify-center text-zinc-300">No Image</div>
      {%- endif -%}
    </div>
  </a>
  
  <div class="flex-grow flex flex-col justify-between">
    <div>
      <a href="{{ product.url }}" class="block">
        <h4 class="text-base text-zinc-900 font-medium mb-1 line-clamp-1 group-hover:text-[#0052FF] transition-colors">{{ product.title | escape }}</h4>
      </a>
      <p class="text-lg font-bold text-zinc-900 mb-2">{{ product.price | money }}</p>
    </div>
    
    <form method="post" action="/cart/add">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button type="submit" class="w-full bg-zinc-100 text-zinc-900 font-bold text-sm py-3 rounded hover:bg-[#0052FF] hover:text-white transition-colors flex justify-center items-center gap-2 mt-2">
        Add to Cart
      </button>
    </form>
  </div>
</div>