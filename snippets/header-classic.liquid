{% comment %}Header Classic Style - LUXE Theme{% endcomment %}

<div class="flex items-center gap-8">
  <a href="{{ routes.root_url }}" class="text-xl font-black tracking-tighter text-zinc-900">
    {% if settings.logo != blank %}
      {% assign logo_height = settings.logo.width | divided_by: settings.logo.width | times: 60 %}
      <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name | escape }}" width="200" height="{{ logo_height }}">
    {% else %}
      {{ shop.name }}
    {% endif %}
  </a>
  
  <div class="hidden md:flex gap-6 text-sm font-medium tracking-tight">
    {% for link in linklists.main-menu.links %}
      <a href="{{ link.url }}" class="text-zinc-500 hover:text-zinc-900 transition-colors hover:opacity-70">
        {{ link.title }}
      </a>
    {% endfor %}
  </div>
</div>

<div class="flex items-center gap-4 text-blue-600">
  <div class="hidden md:flex items-center border border-zinc-200 rounded px-3 py-1">
    <svg class="material-symbols-outlined text-sm text-zinc-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
    </svg>
    <form action="{{ routes.search_url }}" method="get" class="flex items-center">
      <input 
        type="text" 
        name="q" 
        placeholder="Search..." 
        class="bg-transparent border-none focus:ring-0 text-sm w-32 placeholder-zinc-400 p-0 text-[var(--color-text-primary)]"
      >
    </form>
  </div>
  
  <a href="{{ routes.cart_url }}" class="hover:opacity-70 transition-opacity relative">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
    </svg>
    {% if cart.item_count > 0 %}
      <span class="absolute -top-2 -right-2 bg-[var(--color-primary)] text-white text-xs w-5 h-5 rounded-full flex items-center justify-center">
        {{ cart.item_count }}
      </span>
    {% endif %}
  </a>
  
  {% if customer %}
    <a href="{{ routes.account_url }}" class="hover:opacity-70 transition-opacity">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
      </svg>
    </a>
  {% else %}
    <a href="{{ routes.account_login_url }}" class="hover:opacity-70 transition-opacity">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
      </svg>
    </a>
  {% endif %}
</div>