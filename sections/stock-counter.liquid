{% comment %}Stock Counter Section - LUXE Theme{% endcomment %}

<div class="stock-counter" data-stock="{{ section.settings.stock }}" data-low-stock="{{ section.settings.low_stock }}">
  {% if section.settings.show_progress %}
    <div class="mb-3">
      <div class="h-2 bg-zinc-200 rounded-full overflow-hidden">
        <div class="h-full bg-green-500 transition-all duration-500" id="stock-bar" style="width: 100%"></div>
      </div>
    </div>
  {% endif %}
  
  <p class="text-sm">
    {% if section.settings.stock > 0 %}
      <span class="text-green-600 font-medium">✓ In Stock</span>
      {% if section.settings.show_count %}
        <span class="text-zinc-500"> - Only <span class="font-bold text-zinc-900">{{ section.settings.stock }}</span> left!</span>
      {% endif %}
    {% else %}
      <span class="text-red-600 font-medium">✕ Out of Stock</span>
    {% endif %}
  </p>
</div>

{% if section.settings.show_progress %}
<script>
(function() {
  const counter = document.querySelector('.stock-counter');
  if (!counter) return;
  
  const stock = parseInt(counter.dataset.stock);
  const lowStock = parseInt(counter.dataset.lowStock);
  const bar = document.getElementById('stock-bar');
  
  const percentage = Math.min((stock / 50) * 100, 100);
  bar.style.width = percentage + '%';
  
  if (stock <= lowStock) {
    bar.classList.remove('bg-green-500');
    bar.classList.add('bg-red-500');
  } else if (stock <= lowStock * 2) {
    bar.classList.remove('bg-green-500');
    bar.classList.add('bg-yellow-500');
  }
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Stock Counter",
  "class": "section-stock-counter",
  "settings": [
    { "type": "range", "id": "stock", "label": "Stock Quantity", "min": 0, "max": 100, "default": 10 },
    { "type": "range", "id": "low_stock", "label": "Low Stock Threshold", "min": 1, "max": 20, "default": 5 },
    { "type": "checkbox", "id": "show_count", "label": "Show Remaining Count", "default": true },
    { "type": "checkbox", "id": "show_progress", "label": "Show Progress Bar", "default": true }
  ],
  "presets": [{ "name": "Stock Counter" }]
}
{% endschema %}