{% comment %}
  Upsell Popup Section - LUXE Theme
  Dropshipping: One-click post-purchase upsell
{% endcomment %}

<div class="upsell-popup fixed inset-0 z-50 hidden" id="upsellPopup">
  <div class="upsell-popup__overlay fixed inset-0 bg-black/50" onclick="closeUpsell()"></div>
  <div class="upsell-popup__content fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-lg bg-white rounded p-8">
    <button type="button" class="upsell-popup__close absolute top-4 right-4 p-2" onclick="closeUpsell()">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <div class="text-center">
      <span class="inline-block px-3 py-1 text-sm font-semibold rounded mb-4" style="background: var(--color-primary); color: var(--color-text-inverse);">
        {{ section.settings.badge_text | default: 'Special Offer' }}
      </span>

      <h2 class="text-2xl font-bold mb-2">{{ section.settings.heading | default: 'Complete Your Order' }}</h2>
      <p class="mb-6" style="color: var(--color-text-secondary);">{{ section.settings.message }}</p>
    </div>

    {%- assign upsell_product = all_products[section.settings.product] -%}
    {%- if upsell_product != blank -%}
      <div class="upsell-popup__product flex gap-4 p-4 rounded mb-6" style="background: var(--color-surface);">
        {%- if upsell_product.featured_media != blank -%}
          {{ upsell_product.featured_media | image_url: width: 120 | image_tag: class: 'w-24 h-24 object-cover rounded' }}
        {%- endif -%}
        <div class="flex-1">
          <h3 class="font-semibold">{{ upsell_product.title | escape }}</h3>
          <p class="text-sm mb-2" style="color: var(--color-text-secondary);">{{ upsell_product.price | money }}</p>
          <button
            type="button"
            class="w-full py-2 px-4 font-semibold rounded text-sm"
            style="background: var(--color-primary); color: var(--color-text-inverse);"
            onclick="addUpsell()"
          >
            {{ section.settings.button_text | default: 'Add to Order' }} - {{ upsell_product.price | money }}
          </button>
        </div>
      </div>
    {%- endif -%}

    <div class="text-center">
      <button type="button" class="text-sm underline" onclick="closeUpsell()">
        {{ section.settings.skip_text | default: 'No thanks, continue to checkout' }}
      </button>
    </div>
  </div>
</div>

<script>
  (function() {
    const popup = document.getElementById('upsellPopup');
    let shown = false;

    window.showUpsell = function() {
      if (shown) return;
      popup.classList.remove('hidden');
      shown = true;
      document.body.style.overflow = 'hidden';
    };

    window.closeUpsell = function() {
      popup.classList.add('hidden');
      document.body.style.overflow = '';
    };

    window.addUpsell = function() {
      {%- if section.settings.product != blank -%}
        {%- assign upsell_product = all_products[section.settings.product] -%}
        {%- if upsell_product != blank -%}
          window.vrenyaCart.cart.addItem('{{ upsell_product.selected_or_first_available_variant.id }}', 1);
        {%- endif -%}
      {%- endif -%}
      closeUpsell();
    };

    // Auto-show after add to cart (optional)
    {%- if section.settings.auto_show -%}
    setTimeout(showUpsell, {{ section.settings.delay | default: 3000 }});
    {%- endif -%}
  })();
</script>

{% schema %}
{
  "name": "Upsell Popup",
  "class": "section-upsell",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete Your Order"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Special Offer"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Message",
      "default": "Add this item to your order and save 20%"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Upsell Product"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Add to Order"
    },
    {
      "type": "text",
      "id": "skip_text",
      "label": "Skip Link Text",
      "default": "No thanks, continue to checkout"
    },
    {
      "type": "checkbox",
      "id": "auto_show",
      "label": "Auto-show on cart",
      "default": true
    },
    {
      "type": "range",
      "id": "delay",
      "label": "Delay (ms)",
      "min": 1000,
      "max": 9500,
      "default": 3000,
      "step": 500
    }
  ],
  "presets": [
    {
      "name": "Upsell Popup"
    }
  ]
}
{% endschema %}