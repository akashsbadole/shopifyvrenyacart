{% comment %}Blog Page Section - LUXE Theme{% endcomment %}

<section class="max-w-[1440px] mx-auto px-6 md:px-12 py-12">
  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-[var(--color-text-primary)] mb-4">{{ blog.title }}</h1>
    <p class="text-lg text-[var(--color-text-secondary)]">{{ blog.description }}</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {% for article in blog.articles %}
      <a class="group block" href="{{ article.url }}">
        <div class="aspect-[3/4] bg-[var(--color-surface)] overflow-hidden mb-4">
          {% if article.image %}
            {{ article.image | image_url: width: 600 | image_tag: class: 'w-full h-full object-cover group-hover:scale-105 transition-transform duration-500', loading: 'lazy' }}
          {% else %}
            <div class="w-full h-full flex items-center justify-center bg-[var(--color-surface)]">
              <span class="text-4xl text-[var(--color-border-subtle)]">📰</span>
            </div>
          {% endif %}
        </div>
        <div class="text-sm text-[var(--color-primary)] mb-2">{{ article.published_at | date: '%b %d, %Y' }}</div>
        <h2 class="text-xl font-semibold text-[var(--color-text-primary)] mb-2 group-hover:text-[var(--color-primary)] transition-colors">{{ article.title }}</h2>
        <p class="text-base text-[var(--color-text-secondary)] line-clamp-3">{{ article.excerpt }}</p>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "class": "section-blog",
  "settings": []
}
{% endschema %}