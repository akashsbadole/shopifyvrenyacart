{% comment %}Countdown Timer Section - LUXE Theme{% endcomment %}

<div class="countdown-timer" data-countdown="{{ section.settings.end_date }}" data-message="{{ section.settings.message }}">
  {% if section.settings.title != blank %}
    <h3 class="text-lg font-bold text-zinc-900 mb-4">{{ section.settings.title }}</h3>
  {% endif %}
  
  <div class="flex gap-4" role="timer" aria-live="polite">
    <div class="text-center">
      <div class="w-16 h-16 bg-[#0052FF] text-white rounded-lg flex items-center justify-center text-2xl font-bold" id="countdown-days">00</div>
      <div class="text-xs text-zinc-500 mt-1 uppercase tracking-wider">Days</div>
    </div>
    <div class="text-center">
      <div class="w-16 h-16 bg-[#0052FF] text-white rounded-lg flex items-center justify-center text-2xl font-bold" id="countdown-hours">00</div>
      <div class="text-xs text-zinc-500 mt-1 uppercase tracking-wider">Hours</div>
    </div>
    <div class="text-center">
      <div class="w-16 h-16 bg-[#0052FF] text-white rounded-lg flex items-center justify-center text-2xl font-bold" id="countdown-minutes">00</div>
      <div class="text-xs text-zinc-500 mt-1 uppercase tracking-wider">Min</div>
    </div>
    <div class="text-center">
      <div class="w-16 h-16 bg-[#0052FF] text-white rounded-lg flex items-center justify-center text-2xl font-bold" id="countdown-seconds">00</div>
      <div class="text-xs text-zinc-500 mt-1 uppercase tracking-wider">Sec</div>
    </div>
  </div>
  
  {% if section.settings.message != blank %}
    <p class="text-sm text-zinc-600 mt-4">{{ section.settings.message }}</p>
  {% endif %}
</div>

<script>
(function() {
  const countdown = document.querySelector('[data-countdown]');
  if (!countdown) return;
  
  const endDate = new Date(countdown.dataset.countdown).getTime();
  
  function updateCountdown() {
    const now = new Date().getTime();
    const distance = endDate - now;
    
    if (distance < 0) {
      countdown.innerHTML = '<p class="text-zinc-600">' + (countdown.dataset.message || 'Offer has ended') + '</p>';
      return;
    }
    
    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((distance % (1000 * 60)) / 1000);
    
    document.getElementById('countdown-days').textContent = String(days).padStart(2, '0');
    document.getElementById('countdown-hours').textContent = String(hours).padStart(2, '0');
    document.getElementById('countdown-minutes').textContent = String(minutes).padStart(2, '0');
    document.getElementById('countdown-seconds').textContent = String(seconds).padStart(2, '0');
  }
  
  updateCountdown();
  setInterval(updateCountdown, 1000);
})();
</script>

{% schema %}
{
  "name": "Countdown Timer",
  "class": "section-countdown",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Limited Offer" },
    { "type": "text", "id": "end_date", "label": "End Date", "info": "Format: YYYY-MM-DDTHH:MM:SS" },
    { "type": "text", "id": "message", "label": "End Message" }
  ],
  "presets": [{ "name": "Countdown Timer" }]
}
{% endschema %}