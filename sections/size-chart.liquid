{% comment %}
  Size Chart Section - LUXE Theme
  Fashion niche: Size guide modal
{% endcomment %}

<section class="size-chart py-12">
  <button
    type="button"
    class="size-chart__trigger inline-flex items-center gap-2 text-sm font-semibold underline"
    style="color: var(--color-primary);"
    onclick="openSizeChart()"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
    </svg>
    {{ section.settings.trigger_text | default: 'Size Guide' }}
  </button>
</section>

<div class="size-chart-modal fixed inset-0 z-50 hidden" id="sizeChartModal">
  <div class="size-chart__overlay fixed inset-0 bg-black/50" onclick="closeSizeChart()"></div>
  <div class="size-chart__content fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl max-h-[90vh] overflow-auto bg-white rounded p-8">
    <button type="button" class="size-chart__close absolute top-4 right-4 p-2" onclick="closeSizeChart()">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <h2 class="text-2xl font-bold mb-6">{{ section.settings.heading | default: 'Size Guide' }}</h2>

    <div class="size-chart__table overflow-x-auto">
      <table class="w-full border-collapse">
        <thead>
          <tr>
            <th class="p-3 text-left text-sm font-semibold" style="background: var(--color-surface);">Size</th>
            <th class="p-3 text-center text-sm font-semibold" style="background: var(--color-surface);">Chest</th>
            <th class="p-3 text-center text-sm font-semibold" style="background: var(--color-surface);">Waist</th>
            <th class="p-3 text-center text-sm font-semibold" style="background: var(--color-surface);">Hip</th>
            <th class="p-3 text-center text-sm font-semibold" style="background: var(--color-surface);">Length</th>
          </tr>
        </thead>
        <tbody>
          {%- for row in (1..section.settings.size_count) -%}
            {%- assign size_key = 'size_' | append: row -%}
            {%- assign chest_key = 'chest_' | append: row -%}
            {%- assign waist_key = 'waist_' | append: row -%}
            {%- assign hip_key = 'hip_' | append: row -%}
            {%- assign length_key = 'length_' | append: row -%}
            <tr class="border-t" style="border-color: var(--color-border-subtle);">
              <td class="p-3 font-medium">{{ section.settings[size_key] }}</td>
              <td class="p-3 text-center">{{ section.settings[chest_key] }}</td>
              <td class="p-3 text-center">{{ section.settings[waist_key] }}</td>
              <td class="p-3 text-center">{{ section.settings[hip_key] }}</td>
              <td class="p-3 text-center">{{ section.settings[length_key] }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if section.settings.notes != blank -%}
      <div class="size-chart__notes mt-6 p-4 rounded" style="background: var(--color-surface);">
        <p class="text-sm">{{ section.settings.notes }}</p>
      </div>
    {%- endif -%}

    <div class="size-chart__fit-guide mt-6">
      <h3 class="font-semibold mb-2">Fit Guide</h3>
      <div class="grid grid-cols-3 gap-4">
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-2 rounded-full flex items-center justify-center" style="background: var(--color-primary); color: white;">S</div>
          <p class="text-sm">Slim</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-2 rounded-full flex items-center justify-center" style="background: var(--color-surface);">R</div>
          <p class="text-sm">Regular</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-2 rounded-full flex items-center justify-center" style="background: var(--color-surface);">O</div>
          <p class="text-sm">Oversized</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Size Chart",
  "class": "section-size-chart",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "trigger_text",
      "label": "Trigger Button Text",
      "default": "Size Guide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Modal Heading",
      "default": "Size Guide"
    },
    {
      "type": "range",
      "id": "size_count",
      "label": "Number of Sizes",
      "min": 3,
      "max": 8,
      "default": 5,
      "step": 1
    },
    {
      "type": "text",
      "id": "size_1",
      "label": "Size 1",
      "default": "XS"
    },
    {
      "type": "text",
      "id": "chest_1",
      "label": "Size 1 Chest",
      "default": "32-34\""
    },
    {
      "type": "text",
      "id": "waist_1",
      "label": "Size 1 Waist",
      "default": "26-28\""
    },
    {
      "type": "text",
      "id": "hip_1",
      "label": "Size 1 Hip",
      "default": "32-34\""
    },
    {
      "type": "text",
      "id": "length_1",
      "label": "Size 1 Length",
      "default": "26\""
    },
    {
      "type": "text",
      "id": "size_2",
      "label": "Size 2",
      "default": "S"
    },
    {
      "type": "text",
      "id": "chest_2",
      "label": "Size 2 Chest",
      "default": "34-36\""
    },
    {
      "type": "text",
      "id": "waist_2",
      "label": "Size 2 Waist",
      "default": "28-30\""
    },
    {
      "type": "text",
      "id": "hip_2",
      "label": "Size 2 Hip",
      "default": "34-36\""
    },
    {
      "type": "text",
      "id": "length_2",
      "label": "Size 2 Length",
      "default": "27\""
    },
    {
      "type": "text",
      "id": "size_3",
      "label": "Size 3",
      "default": "M"
    },
    {
      "type": "text",
      "id": "chest_3",
      "label": "Size 3 Chest",
      "default": "36-38\""
    },
    {
      "type": "text",
      "id": "waist_3",
      "label": "Size 3 Waist",
      "default": "30-32\""
    },
    {
      "type": "text",
      "id": "hip_3",
      "label": "Size 3 Hip",
      "default": "36-38\""
    },
    {
      "type": "text",
      "id": "length_3",
      "label": "Size 3 Length",
      "default": "28\""
    },
    {
      "type": "text",
      "id": "size_4",
      "label": "Size 4",
      "default": "L"
    },
    {
      "type": "text",
      "id": "size_5",
      "label": "Size 5",
      "default": "XL"
    },
    {
      "type": "textarea",
      "id": "notes",
      "label": "Additional Notes",
      "default": "Measurements are in inches. For best fit, measure a similar garment you own."
    }
  ],
  "presets": [
    {
      "name": "Size Chart"
    }
  ]
}
{% endschema %}