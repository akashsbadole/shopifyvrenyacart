{% comment %}404 Page Section - LUXE Theme{% endcomment %}

<section class="max-w-[1440px] mx-auto px-6 md:px-12 py-24 md:py-32 min-h-[60vh] flex flex-col items-center justify-center text-center">
  <h1 class="text-6xl md:text-8xl font-bold text-[var(--color-text-primary)] mb-6 tracking-tight">404</h1>
  <p class="text-2xl md:text-3xl font-semibold text-[var(--color-text-secondary)] mb-3">Page Not Found</p>
  <p class="text-lg text-[var(--color-text-secondary)] mb-8 max-w-md">The page you are looking for has been moved, removed, renamed, or might never have existed.</p>
  <a 
    class="inline-flex items-center justify-center bg-[var(--color-primary)] text-white font-bold text-sm px-8 py-4 rounded hover:opacity-90 transition-opacity"
    href="{{ routes.root_url }}"
  >
    Return to Shop
  </a>
</section>

<section class="max-w-[1440px] mx-auto px-6 md:px-12 pb-24">
  <h2 class="text-3xl font-semibold text-[var(--color-text-primary)] mb-8">Recommended for You</h2>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
    {% for product in collections.frontpage.products limit: 4 %}
      <a class="group block" href="{{ product.url }}">
        <div class="aspect-[3/4] bg-[var(--color-surface)] overflow-hidden mb-4">
          {% if product.featured_media %}
            {{ product.featured_media | image_url: width: 400 | image_tag: class: 'w-full h-full object-cover group-hover:scale-105 transition-transform duration-500', loading: 'lazy' }}
          {% else %}
            <div class="w-full h-full flex items-center justify-center bg-[var(--color-surface)]">
              <span class="text-[var(--color-border-subtle)]">Product Image</span>
            </div>
          {% endif %}
        </div>
        <h3 class="text-base text-[var(--color-text-primary)] mb-2 group-hover:text-[var(--color-primary)] transition-colors">{{ product.title }}</h3>
        <p class="text-lg font-bold text-[var(--color-text-primary)]">{{ product.price | money }}</p>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "404 Page",
  "tag": "section",
  "class": "section-404",
  "settings": []
}
{% endschema %}