{% comment %}Header Section - LUXE Theme{% endcomment %}

{%- style -%}
.header {
  --header-height: 80px;
}
.header-wrapper {
  position: sticky;
  top: 0;
  z-index: 50;
  background: white;
}
@media (max-width: 768px) {
  .header {
    --header-height: 64px;
  }
}
{%- endstyle -%}

<div class="header-wrapper bg-white border-b border-zinc-100 flat no shadows">
  <header class="header flex justify-between items-center w-full px-6 md:px-12 h-20 max-w-[1440px] mx-auto">
    <div class="flex items-center gap-8">
      <a href="{{ routes.root_url }}" class="text-xl font-black tracking-tighter text-zinc-900">
        {% if settings.logo != blank %}
          <img src="{{ settings.logo | image_url: width: 100 }}" alt="{{ shop.name | escape }}" width="100">
        {% else %}
          LUXE
        {% endif %}
      </a>
      <div class="hidden md:flex gap-6 text-sm font-medium tracking-tight">
        {% for link in linklists.main-menu.links %}
          <a href="{{ link.url }}" class="text-zinc-500 hover:text-zinc-900 transition-colors hover:opacity-70">
            {{ link.title }}
          </a>
        {% endfor %}
      </div>
    </div>
    <div class="flex items-center gap-4 text-blue-600">
      <div class="hidden md:flex items-center border border-zinc-200 rounded px-3 py-1">
        <svg class="w-4 h-4 text-zinc-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <form action="{{ routes.search_url }}" method="get" class="flex items-center">
          <input type="text" name="q" placeholder="Search..." class="bg-transparent border-none focus:ring-0 text-sm w-32 placeholder-zinc-400 p-0 text-zinc-900">
        </form>
      </div>
      <a href="{{ routes.cart_url }}" data-open-cart class="hover:opacity-70 transition-opacity relative">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
        </svg>
        {% if cart.item_count > 0 %}
          <span class="absolute -top-2 -right-2 bg-[#0052FF] text-white text-xs w-5 h-5 rounded-full flex items-center justify-center">
            {{ cart.item_count }}
          </span>
        {% endif %}
      </a>
      {% if customer %}
        <a href="{{ routes.account_url }}" class="hover:opacity-70 transition-opacity">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </a>
      {% else %}
        <a href="{{ routes.account_login_url }}" class="hover:opacity-70 transition-opacity">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </a>
      {% endif %}
    </div>
  </header>
</div>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "tag": "header",
  "settings": []
}
{% endschema %}