{% comment %}Breadcrumbs Section - LUXE Theme{% endcomment %}

<nav class="breadcrumbs py-4 px-6 md:px-12 max-w-[1440px] mx-auto" aria-label="Breadcrumb">
  <ol class="flex items-center gap-2 text-sm">
    <li>
      <a href="{{ routes.root_url }}" class="text-zinc-500 hover:text-[#0052FF] transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
      </a>
    </li>
    
    {% if template contains 'product' %}
      {% if collection %}
        <li class="text-zinc-400">/</li>
        <li>
          <a href="{{ collection.url }}" class="text-zinc-500 hover:text-[#0052FF] transition-colors">{{ collection.title }}</a>
        </li>
      {% endif %}
      <li class="text-zinc-400">/</li>
      <li class="text-zinc-900 font-medium" aria-current="page">{{ product.title }}</li>
    
    {% elsif template contains 'collection' %}
      <li class="text-zinc-400">/</li>
      <li class="text-zinc-900 font-medium" aria-current="page">{{ collection.title }}</li>
    
    {% elsif template contains 'blog' %}
      <li class="text-zinc-400">/</li>
      <li>
        <a href="{{ blog.url }}" class="text-zinc-500 hover:text-[#0052FF] transition-colors">{{ blog.title }}</a>
      </li>
      {% if article %}
        <li class="text-zinc-400">/</li>
        <li class="text-zinc-900 font-medium" aria-current="page">{{ article.title }}</li>
      {% endif %}
    
    {% elsif template == 'page' %}
      <li class="text-zinc-400">/</li>
      <li class="text-zinc-900 font-medium" aria-current="page">{{ page.title }}</li>
    
    {% elsif template == 'cart' %}
      <li class="text-zinc-400">/</li>
      <li class="text-zinc-900 font-medium" aria-current="page">Cart</li>
    
    {% elsif template contains 'customers' %}
      <li class="text-zinc-400">/</li>
      <li class="text-zinc-900 font-medium" aria-current="page">My Account</li>
    {% endif %}
  </ol>
</nav>

{% schema %}
{
  "name": "Breadcrumbs",
  "class": "section-breadcrumbs",
  "settings": [],
  "presets": [{ "name": "Breadcrumbs" }]
}
{% endschema %}