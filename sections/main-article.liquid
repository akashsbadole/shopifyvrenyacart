{% comment %}Article Page Section - LUXE Theme{% endcomment %}

<article class="max-w-[1440px] mx-auto px-6 md:px-12 py-12">
  <div class="max-w-3xl mx-auto">
    <a href="{{ blog.url }}" class="text-sm text-[var(--color-primary)] hover:opacity-70 mb-4 inline-block">← Back to {{ blog.title }}</a>
    
    <h1 class="text-4xl md:text-5xl font-bold text-[var(--color-text-primary)] mb-4">{{ article.title }}</h1>
    
    <div class="text-base text-[var(--color-text-secondary)] mb-8">
      {{ article.published_at | date: '%B %d, %Y' }}
      {% if article.author %} • {{ article.author }}{% endif %}
    </div>

    {% if article.image %}
      <div class="aspect-[16/9] bg-[var(--color-surface)] overflow-hidden mb-8">
        {{ article.image | image_url: width: 1200 | image_tag: class: 'w-full h-full object-cover', loading: 'lazy' }}
      </div>
    {% endif %}

    <div class="prose prose-lg text-[var(--color-text-secondary)]">
      {{ article.content }}
    </div>

    {% if article.tags.size > 0 %}
      <div class="mt-8 pt-8 border-t border-[var(--color-border-subtle)]">
        <div class="flex gap-2 flex-wrap">
          {% for tag in article.tags %}
            <span class="text-sm px-3 py-1 bg-[var(--color-surface)] rounded text-[var(--color-text-secondary)]">{{ tag }}</span>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "tag": "section",
  "class": "section-article",
  "settings": []
}
{% endschema %}