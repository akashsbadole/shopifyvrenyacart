{% comment %}Collection Page Section - LUXE Theme{% endcomment %}

<section class="max-w-[1440px] mx-auto px-6 md:px-12 py-8">
  {% if collection.image %}
    <div class="relative h-64 md:h-96 mb-8 overflow-hidden rounded">
      {{ collection.image | image_url: width: 2000 | image_tag: class: 'w-full h-full object-cover', loading: 'lazy' }}
      <div class="absolute inset-0 bg-black/40 flex items-center justify-center">
        <h1 class="text-4xl md:text-6xl font-bold text-white">{{ collection.title }}</h1>
      </div>
    </div>
  {% else %}
    <h1 class="text-4xl font-bold text-zinc-900 mb-8">{{ collection.title }}</h1>
  {% endif %}

  {% if collection.description != blank %}
    <p class="text-lg text-zinc-600 mb-8">{{ collection.description }}</p>
  {% endif %}

  {% if collection.products.size > 0 %}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-8">
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
  {% else %}
    <div class="text-center py-16">
      <p class="text-xl text-zinc-600 mb-6">No products found in this collection.</p>
      <a href="{{ routes.collections_url }}" class="text-[#0052FF] hover:opacity-70">Browse all collections</a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Collection Page",
  "tag": "section",
  "class": "section-collection",
  "settings": []
}
{% endschema %}