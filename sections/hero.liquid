{% comment %}
  Hero Section - LUXE Theme
{% endcomment %}

{%- style -%}
  .hero {
    min-height: {{ section.settings.height }}px;
  }

  .hero__overlay {
    background: linear-gradient(
      {{ section.settings.overlay_direction | default: 'to bottom' }},
      rgba(0, 0, 0, {{ section.settings.overlay_opacity | default: 0 | divided_by: 100.0 }}),
      rgba(0, 0, 0, {{ section.settings.overlay_opacity_end | default: 0 | divided_by: 100.0 }})
    );
  }
{%- endstyle -%}

<section class="hero relative overflow-hidden flex items-center justify-center" style="background-color: {{ section.settings.bg_color }};">
  {%- if section.settings.image != blank -%}
    <div class="hero__bg absolute inset-0">
      {{ section.settings.image | image_url: width: 2000 | image_tag:
        class: 'w-full h-full object-cover',
        loading: 'eager'
      }}
    </div>
  {%- endif -%}

  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="hero__overlay absolute inset-0"></div>
  {%- endif -%}

  <div class="hero__content relative z-10 text-center px-6" style="max-width: {{ section.settings.content_width }}px;">
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading" style="font-size: {{ section.settings.heading_size }}px; font-weight: {{ section.settings.heading_weight }}; color: {{ section.settings.text_color }};">
        {{ section.settings.heading }}
      </h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="hero__subheading mt-4" style="font-size: {{ section.settings.subheading_size }}px; color: {{ section.settings.text_color }};">
        {{ section.settings.subheading }}
      </p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        href="{{ section.settings.button_link }}"
        class="hero__button inline-flex items-center gap-2 mt-8 px-8 py-4 font-semibold rounded hover:opacity-90 transition-opacity"
        style="background: {{ section.settings.button_color }}; color: {{ section.settings.button_text_color }};"
      >
        {{ section.settings.button_label }}
        {%- if section.settings.button_icon == 'arrow' -%}
          <span aria-hidden="true">&rarr;</span>
        {%- endif -%}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fallback background color",
      "default": "#f5f5f5"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "default": 0,
      "step": 5,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "overlay_opacity_end",
      "label": "Overlay opacity (bottom)",
      "min": 0,
      "max": 80,
      "default": 0,
      "step": 5,
      "unit": "%"
    },
    {
      "type": "select",
      "id": "overlay_direction",
      "label": "Overlay direction",
      "options": [
        {"value": "to bottom", "label": "Top to bottom"},
        {"value": "to right", "label": "Left to right"}
      ],
      "default": "to bottom"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The New Standard"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 32,
      "max": 96,
      "default": 64,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        {"value": "400", "label": "Regular"},
        {"value": "500", "label": "Medium"},
        {"value": "600", "label": "Semi Bold"},
        {"value": "700", "label": "Bold"},
        {"value": "800", "label": "Extra Bold"},
        {"value": "900", "label": "Black"}
      ],
      "default": "700"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Experience a frictionless, premium shopping environment."
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 14,
      "max": 28,
      "default": 18,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#18181b"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content max width",
      "min": 400,
      "max": 1000,
      "default": 600,
      "step": 50,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop New Arrivals"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_icon",
      "label": "Button icon",
      "options": [
        {"value": "none", "label": "None"},
        {"value": "arrow", "label": "Arrow"}
      ],
      "default": "arrow"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#0052FF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Section height",
      "min": 400,
      "max": 1000,
      "default": 700,
      "step": 50,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}