{% comment %}
  Trust Badges Section - LUXE Theme
  Conversion: Security seals and payment icons
{% endcomment %}

<section class="trust-badges py-12">
  <div class="container mx-auto px-6" style="max-width: var(--container-width);">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {%- if section.settings.show_shipping -%}
      <div class="trust-badges__item text-center">
        <svg class="w-12 h-12 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-primary);">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
        </svg>
        <h3 class="font-semibold">{{ section.settings.shipping_title | default: 'Free Shipping' }}</h3>
        <p class="text-sm mt-1" style="color: var(--color-text-secondary);">{{ section.settings.shipping_text | default: 'On orders over $50' }}</p>
      </div>
      {%- endif -%}

      {%- if section.settings.show_secure -%}
      <div class="trust-badges__item text-center">
        <svg class="w-12 h-12 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-primary);">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        <h3 class="font-semibold">{{ section.settings.secure_title | default: 'Secure Checkout' }}</h3>
        <p class="text-sm mt-1" style="color: var(--color-text-secondary);">{{ section.settings.secure_text | default: '256-bit SSL encryption' }}</p>
      </div>
      {%- endif -%}

      {%- if section.settings.show_returns -%}
      <div class="trust-badges__item text-center">
        <svg class="w-12 h-12 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-primary);">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.582 0v5a2 2 0 01-2 2H5.418a2 2 0 01-2-2V5.582m15.582 0a2 2 0 012 2v4.418M4 5h15m-3 5h5v-5h-5V5z"/>
        </svg>
        <h3 class="font-semibold">{{ section.settings.returns_title | default: 'Easy Returns' }}</h3>
        <p class="text-sm mt-1" style="color: var(--color-text-secondary);">{{ section.settings.returns_text | default: '30-day money back' }}</p>
      </div>
      {%- endif -%}

      {%- if section.settings.show_support -%}
      <div class="trust-badges__item text-center">
        <svg class="w-12 h-12 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-primary);">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.364 5.636l-3.536 3.536m0 5.708l3.536 3.536M9.172 9.172L5.636 12.728m0 5.708l3.536-3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <h3 class="font-semibold">{{ section.settings.support_title | default: '24/7 Support' }}</h3>
        <p class="text-sm mt-1" style="color: var(--color-text-secondary);">{{ section.settings.support_text | default: 'Always here to help' }}</p>
      </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_payment_icons -%}
    <div class="trust-badges__payment mt-8 pt-8 text-center" style="border-top: 1px solid var(--color-border-subtle);">
      <p class="text-sm mb-3" style="color: var(--color-text-secondary);">{{ section.settings.payment_text | default: 'We accept' }}</p>
      <div class="flex justify-center gap-3 flex-wrap">
        {% render 'payment-icons' %}
      </div>
    </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust Badges",
  "class": "section-trust",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_shipping",
      "label": "Show Free Shipping",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_title",
      "label": "Shipping Title"
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Shipping Text"
    },
    {
      "type": "checkbox",
      "id": "show_secure",
      "label": "Show Secure Checkout",
      "default": true
    },
    {
      "type": "text",
      "id": "secure_title",
      "label": "Secure Title"
    },
    {
      "type": "text",
      "id": "secure_text",
      "label": "Secure Text"
    },
    {
      "type": "checkbox",
      "id": "show_returns",
      "label": "Show Easy Returns",
      "default": true
    },
    {
      "type": "text",
      "id": "returns_title",
      "label": "Returns Title"
    },
    {
      "type": "text",
      "id": "returns_text",
      "label": "Returns Text"
    },
    {
      "type": "checkbox",
      "id": "show_support",
      "label": "Show 24/7 Support",
      "default": true
    },
    {
      "type": "text",
      "id": "support_title",
      "label": "Support Title"
    },
    {
      "type": "text",
      "id": "support_text",
      "label": "Support Text"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Icons",
      "default": true
    },
    {
      "type": "text",
      "id": "payment_text",
      "label": "Payment Text"
    }
  ],
  "presets": [
    {
      "name": "Trust Badges"
    }
  ]
}
{% endschema %}