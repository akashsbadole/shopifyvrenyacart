{% comment %}Featured Collection Section - LUXE Theme{% endcomment %}

<section class="py-[120px] px-6 md:px-12 max-w-[1440px] mx-auto">
  <div class="mb-8 flex justify-between items-end border-b border-zinc-200 pb-4">
    <h2 class="text-3xl font-semibold text-zinc-900">
      {{ section.settings.heading | default: 'Featured Collection' }}
    </h2>
    <a href="{{ section.settings.collection.url | default: routes.collections_url }}" class="text-sm font-bold text-[#0052FF] hover:text-[#0038b6] transition-colors hidden md:block">
      View All
    </a>
  </div>
  
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-8">
    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection != blank -%}
      {%- for product in collection.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <div class="group flex flex-col relative">
          <div class="bg-white aspect-square p-4 mb-4 flex items-center justify-center border border-zinc-200 group-hover:border-zinc-300 transition-colors">
            <span class="text-zinc-300 text-4xl">📦</span>
          </div>
          <div class="flex-grow flex flex-col justify-between">
            <div>
              <h4 class="text-base text-zinc-900 font-medium mb-1">Sample Product {{ i }}</h4>
              <p class="text-lg font-bold text-zinc-900 mb-2">${{ 20 | times: i }}.00</p>
            </div>
            <button class="w-full bg-zinc-100 text-zinc-900 font-bold text-sm py-3 rounded hover:bg-[#0052FF] hover:text-white transition-colors">
              Add to Cart
            </button>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "class": "section-featured-collection",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "default": 4,
      "step": 1
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}