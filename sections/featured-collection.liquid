{% comment %}
  Featured Collection Section - LUXE Theme
{% endcomment %}

{%- style -%}
  .featured-collection__grid {
    grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
  }
{%- endstyle -%}

<section class="featured-collection py-16" style="padding: var(--section-spacing) 0;">
  <div class="featured-collection__container mx-auto px-6" style="max-width: var(--container-width);">

    {%- if section.settings.heading != blank or section.settings.show_view_all -%}
      <div class="flex items-end justify-between mb-8" style="border-bottom: 1px solid var(--color-border-subtle); padding-bottom: 1rem;">
        <h2 class="text-3xl font-bold" style="font-size: {{ section.settings.heading_size }}px;">
          {{ section.settings.heading | default: collection.title }}
        </h2>
        {%- if section.settings.show_view_all and section.settings.view_all_link != blank -%}
          <a href="{{ section.settings.view_all_link }}" class="text-sm font-semibold uppercase tracking-wider hover:opacity-70 transition-opacity" style="color: var(--color-primary);">
            View All
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign collection = collections[section.settings.collection] -%}

    <div class="featured-collection__grid grid gap-6" style="gap: var(--grid-gutter);">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          {% render 'product-card-placeholder' %}
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "class": "section-featured-collection",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 48,
      "default": 32,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "default": 4,
      "step": 1
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns per row",
      "min": 2,
      "max": 5,
      "default": 4,
      "step": 1
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' link",
      "default": true
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All link"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}