{% comment %}
  Recommended Products - vrenyaCart Theme
  AI-powered product recommendations
{% endcomment %}

<section class="recommended-products py-16">
  <h2 class="text-2xl font-bold text-center mb-8">{{ section.settings.heading | default: 'You May Also Like' }}</h2>
  
  <div class="grid gap-6" style="grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));">
    {%- assign products = section.settings.product_list | split: ',' -%}
    {%- for product_handle in products -%}
      {%- assign product = all_products[product_handle] -%}
      {%- if product != blank -%}
        {% render 'product-card', product: product %}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Recommended Products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You May Also Like" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 5, "default": 4, "step": 1 },
    { "type": "text", "id": "product_list", "label": "Products", "info": "Comma-separated handles" }
  ]
}
{% endschema %}