{% comment %}
  Promo Banner Section - vrenyaCart Theme
  Announcement bar with dismissible option
{% endcomment %}

<div class="promo-banner{% if section.settings.dismissible %} relative{% endif %}{% if section.settings.sticky %} sticky top-0 z-50{% endif %}" style="background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};" data-promo-id="{{ section.settings.promo_id }}">
  <div class="promo-banner__content flex items-center justify-center gap-4 py-3 px-6">
    <p class="text-sm font-medium text-center">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
      {%- else -%}
        {{ section.settings.text }}
      {%- endif -%}
    </p>
    {%- if section.settings.dismissible -%}
    <button type="button" class="promo-banner__close p-1" onclick="dismissPromo('{{ section.settings.promo_id }}')" aria-label="Dismiss">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
    {%- endif -%}
  </div>
</div>

<script>
  function dismissPromo(id) {
    localStorage.setItem('promo_dismissed_' + id, 'true');
    document.querySelector('[data-promo-id="' + id + '"]').style.display = 'none';
  }

  (function() {
    const id = '{{ section.settings.promo_id }}';
    if (localStorage.getItem('promo_dismissed_' + id) === 'true') {
      document.querySelector('[data-promo-id="' + id + '"]').style.display = 'none';
    }
  })();
</script>

{% schema %}
{
  "name": "Promo Banner",
  "class": "section-promo-banner",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "promo_id", "label": "Promo ID", "default": "promo-1" },
    { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $50!" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#18181b" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky", "default": true },
    { "type": "checkbox", "id": "dismissible", "label": "Dismissible", "default": true }
  ],
  "presets": [{ "name": "Promo Banner" }]
}
{% endschema %}