{% comment %}Promo Banner Section - LUXE Theme{% endcomment %}

<div class="promo-banner bg-[#0052FF] text-white py-3 px-6" role="banner" aria-label="Promotion">
  <div class="max-w-[1440px] mx-auto flex items-center justify-center gap-4">
    <p class="text-sm font-medium text-center">
      {% if section.settings.message != blank %}
        {{ section.settings.message }}
      {% else %}
        🎉 Free shipping on orders over $50! Use code: <span class="font-bold">FREESHIP</span>
      {% endif %}
    </p>
    {% if section.settings.show_close %}
      <button onclick="this.closest('.promo-banner').remove()" class="text-white/80 hover:text-white" aria-label="Close">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Promo Banner",
  "class": "section-promo-banner",
  "settings": [
    { "type": "text", "id": "message", "label": "Message" },
    { "type": "checkbox", "id": "show_close", "label": "Show Close Button", "default": true }
  ],
  "presets": [{ "name": "Promo Banner" }]
}
{% endschema %}