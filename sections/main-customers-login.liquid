{% comment %}Customer Login Section - LUXE Theme{% endcomment %}

<section class="max-w-[1440px] mx-auto px-6 md:px-12 py-12">
  <div class="max-w-md mx-auto">
    <h1 class="text-4xl font-bold text-[var(--color-text-primary)] text-center mb-8">Sign In</h1>

    {% form 'customer_login' %}
      {% if form.errors %}
        <div class="bg-red-50 text-red-600 p-4 rounded mb-6">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="space-y-4">
        <div>
          <label for="customer_email" class="block text-sm font-medium text-[var(--color-text-primary)] mb-2">Email</label>
          <input 
            type="email" 
            id="customer_email" 
            name="customer[email]" 
            required
            class="w-full h-12 px-4 border border-[var(--color-border)] rounded bg-[var(--color-surface)] focus:outline-none focus:border-[var(--color-primary)]"
          >
        </div>

        <div>
          <label for="customer_password" class="block text-sm font-medium text-[var(--color-text-primary)] mb-2">Password</label>
          <input 
            type="password" 
            id="customer_password" 
            name="customer[password]" 
            required
            class="w-full h-12 px-4 border border-[var(--color-border)] rounded bg-[var(--color-surface)] focus:outline-none focus:border-[var(--color-primary)]"
          >
        </div>

        <button 
          type="submit" 
          class="w-full h-12 bg-[var(--color-primary)] text-white font-bold rounded hover:opacity-90 transition-opacity"
        >
          Sign In
        </button>
      </div>

      <div class="mt-6 text-center">
        <a href="{{ routes.account_register_url }}" class="text-[var(--color-primary)] hover:opacity-70">Create an account</a>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Customer Login",
  "tag": "section",
  "class": "section-login",
  "settings": []
}
{% endschema %}