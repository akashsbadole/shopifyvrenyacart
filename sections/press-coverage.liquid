{% comment %}
  Press Coverage - vrenyaCart Theme
  Logo slider of press mentions
{% endcomment %}

<section class="press py-12">
  <div class="press__container mx-auto px-6" style="max-width: var(--container-width);">
    {%- if section.settings.heading != blank -%}
      <p class="text-sm font-semibold text-center uppercase tracking-wider mb-8" style="color: var(--color-text-secondary);">{{ section.settings.heading }}</p>
    {%- endif -%}

    <div class="press__logos flex items-center justify-center gap-8 flex-wrap">
      {%- for i in (1..section.settings.logo_count) -%}
        {%- assign image_key = 'logo_' | append: i -%}
        {%- assign link_key = 'link_' | append: i -%}
        
        {%- if section.settings[image_key] != blank -%}
          <a href="{{ section.settings[link_key] | default: '#' }}" class="press__logo grayscale hover:grayscale-0 transition-all opacity-60 hover:opacity-100">
            {{ section.settings[image_key] | image_url: width: 150 | image_tag: class: 'h-12 object-contain' }}
          </a>
        {%- else -%}
          <div class="h-12 flex items-center justify-center" style="width: 150px; color: var(--color-text-secondary);">
            <span class="font-bold">LOGO {{ i }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Press Coverage",
  "class": "section-press",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "As Seen In" },
    { "type": "range", "id": "logo_count", "label": "Number of Logos", "min": 3, "max": 8, "default": 5, "step": 1 },
    { "type": "image_picker", "id": "logo_1", "label": "Logo 1" },
    { "type": "url", "id": "link_1", "label": "Logo 1 Link" },
    { "type": "image_picker", "id": "logo_2", "label": "Logo 2" },
    { "type": "image_picker", "id": "logo_3", "label": "Logo 3" },
    { "type": "image_picker", "id": "logo_4", "label": "Logo 4" },
    { "type": "image_picker", "id": "logo_5", "label": "Logo 5" }
  ],
  "presets": [{ "name": "Press Coverage" }]
}
{% endschema %}