{% comment %}Footer Section - LUXE Theme{% endcomment %}

<footer class="bg-white border-t border-zinc-100 flat no shadows">
  <div class="flex flex-col md:flex-row justify-between items-center gap-8 py-20 px-6 md:px-12 max-w-[1440px] mx-auto">
    <div class="text-lg font-black tracking-tighter text-zinc-900">
      {% if settings.logo != blank %}
        <img src="{{ settings.logo | image_url: width: 120 }}" alt="{{ shop.name | escape }}" width="120">
      {% else %}
        {{ shop.name }}
      {% endif %}
    </div>
    
    <div class="flex flex-wrap justify-center gap-6 text-xs font-bold uppercase tracking-widest">
      <a href="{{ routes.root_url }}" class="text-zinc-400 hover:text-blue-600 transition-colors">Privacy</a>
      <a href="{{ routes.root_url }}" class="text-zinc-400 hover:text-blue-600 transition-colors">Terms</a>
      <a href="{{ routes.root_url }}" class="text-zinc-400 hover:text-blue-600 transition-colors">Returns</a>
      <a href="{{ routes.root_url }}" class="text-zinc-400 hover:text-blue-600 transition-colors">Shipping</a>
      <a href="{{ routes.root_url }}" class="text-zinc-400 hover:text-blue-600 transition-colors">Contact</a>
    </div>
    
    <div class="text-xs font-bold uppercase tracking-widest text-zinc-400">
      {{ section.settings.footer_copyright | default: '© 2024 LUXE. Engineered for Precision.' }}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "text",
      "id": "footer_copyright",
      "label": "Copyright",
      "default": "© 2024 LUXE. Engineered for Precision."
    }
  ]
}
{% endschema %}