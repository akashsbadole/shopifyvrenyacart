{% comment %}Cart Page Section - LUXE Theme{% endcomment %}

<section class="max-w-[1440px] mx-auto px-6 md:px-12 py-12">
  <h1 class="text-4xl font-bold text-zinc-900 mb-8">Shopping Cart</h1>

  {% if cart.items.size > 0 %}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2">
        <div class="space-y-6">
          {% for item in cart.items %}
            <div class="flex gap-6 pb-6 border-b border-zinc-200">
              <div class="w-24 h-32 bg-white flex-shrink-0 border border-zinc-200">
                {% if item.image %}
                  {{ item.image | image_url: width: 200 | image_tag: class: 'w-full h-full object-contain', loading: 'lazy' }}
                {% endif %}
              </div>
              <div class="flex-1">
                <a href="{{ item.url }}" class="text-lg font-semibold text-zinc-900 hover:text-[#0052FF]">{{ item.product.title }}</a>
                {% unless item.product.has_only_default_variant %}
                  <p class="text-sm text-zinc-500">{{ item.variant.title }}</p>
                {% endunless %}
                <div class="mt-2 flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <label class="text-sm text-zinc-500">Qty:</label>
                    <input 
                      type="number" 
                      name="updates[]" 
                      value="{{ item.quantity }}" 
                      min="1" 
                      class="w-16 h-10 border border-zinc-200 rounded px-2 text-center"
                    >
                  </div>
                  <div class="text-lg font-bold text-zinc-900">{{ item.line_price | money }}</div>
                </div>
              </div>
              <button 
                type="button" 
                class="text-zinc-400 hover:text-red-600"
                onclick="this.closest('form').submit()"
              >
                <span class="sr-only">Remove</span>
                ✕
              </button>
            </div>
          {% endfor %}
        </div>

        <div class="mt-6 flex justify-between">
          <a href="{{ routes.collections_url }}" class="text-[#0052FF] hover:opacity-70">Continue Shopping</a>
          <button type="submit" name="update" class="text-zinc-500 hover:text-[#0052FF]">Update Cart</button>
        </div>
      </div>

      <div>
        <div class="bg-white p-6 rounded border border-zinc-200">
          <h2 class="text-xl font-semibold text-zinc-900 mb-4">Order Summary</h2>
          <div class="space-y-3 text-zinc-600">
            <div class="flex justify-between">
              <span>Subtotal</span>
              <span class="text-zinc-900">{{ cart.total_price | money }}</span>
            </div>
            <div class="flex justify-between">
              <span>Shipping</span>
              <span>Calculated at checkout</span>
            </div>
          </div>
          <div class="mt-4 pt-4 border-t border-zinc-200 flex justify-between text-lg font-bold">
            <span>Total</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <a 
            href="{{ routes.checkout_url }}" 
            class="block w-full mt-6 py-4 bg-[#0052FF] text-white text-center font-bold rounded hover:bg-[#0038b6] transition-colors"
          >
            Proceed to Checkout
          </a>
        </div>
      </div>
    </div>
  {% else %}
    <div class="text-center py-16">
      <p class="text-xl text-zinc-600 mb-6">Your cart is empty</p>
      <a 
        href="{{ routes.collections_url }}" 
        class="inline-block px-8 py-4 bg-[#0052FF] text-white font-bold rounded hover:bg-[#0038b6] transition-colors"
      >
        Start Shopping
      </a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "class": "section-cart",
  "settings": []
}
{% endschema %}