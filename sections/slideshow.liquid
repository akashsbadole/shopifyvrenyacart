{% comment %}
  Slideshow Section - vrenyaCart Theme
{% endcomment %}

<section class="slideshow relative overflow-hidden" data-slideshow data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed }}">
  <div class="slideshow__track flex transition-transform duration-500">
    {%- for i in (1..section.settings.slide_count) -%}
      {%- assign image_key = 'slide_image_' | append: i -%}
      {%- assign heading_key = 'slide_heading_' | append: i -%}
      {%- assign subheading_key = 'slide_subheading_' | append: i -%}
      {%- assign button_key = 'slide_button_' | append: i -%}
      {%- assign link_key = 'slide_link_' | append: i -%}
      
      <div class="slideshow__slide flex-shrink-0 w-full" data-slide="{{ i }}">
        <div class="relative" style="min-height: {{ section.settings.height }}px;">
          {%- if section.settings[image_key] != blank -%}
            {{ section.settings[image_key] | image_url: width: 2000 | image_tag: class: 'absolute inset-0 w-full h-full object-cover', loading: 'eager' }}
          {%- else -%}
            <div class="absolute inset-0 flex items-center justify-center" style="background: var(--color-surface);">
              <span class="text-4xl font-bold" style="color: var(--color-border-subtle);">Slide {{ i }}</span>
            </div>
          {%- endif -%}
          
          {%- if section.settings[heading_key] != blank -%}
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="text-center px-6" style="max-width: {{ section.settings.content_width }}px;">
              {%- if section.settings[subheading_key] != blank -%}
              <p class="text-sm font-semibold uppercase tracking-wider mb-4" style="color: var(--color-primary);">{{ section.settings[subheading_key] }}</p>
              {%- endif -%}
              <h2 class="text-4xl md:text-6xl font-bold mb-6">{{ section.settings[heading_key] }}</h2>
              {%- if section.settings[button_key] != blank -%}
              <a href="{{ section.settings[link_key] }}" class="inline-block py-4 px-8 font-semibold rounded" style="background: var(--color-primary); color: var(--color-text-inverse);">
                {{ section.settings[button_key] }}
              </a>
              {%- endif -%}
            </div>
          </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.show_arrows -%}
  <button type="button" class="slideshow__arrow slideshow__prev absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full flex items-center justify-center" style="background: var(--color-surface);" onclick="prevSlide()" aria-label="Previous">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
  </button>
  <button type="button" class="slideshow__arrow slideshow__next absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full flex items-center justify-center" style="background: var(--color-surface);" onclick="nextSlide()" aria-label="Next">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </button>
  {%- endif -%}

  {%- if section.settings.show_dots -%}
  <div class="slideshow__dots absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2">
    {%- for i in (1..section.settings.slide_count) -%}
    <button type="button" class="slideshow__dot w-2 h-2 rounded-full{% if i == 1 %} bg-primary{% else %} bg-white/50{% endif %}" onclick="goToSlide({{ i }})" aria-label="Go to slide {{ i }}"></button>
    {%- endfor -%}
  </div>
  {%- endif -%}
</section>

<script>
  (function() {
    const slideshow = document.querySelector('[data-slideshow]');
    const track = slideshow.querySelector('.slideshow__track');
    const slides = slideshow.querySelectorAll('[data-slide]');
    const dots = slideshow.querySelectorAll('.slideshow__dot');
    let current = 1;
    const total = slides.length;
    const autoplay = slideshow.dataset.autoplay === 'true';
    const speed = parseInt(slideshow.dataset.speed) || 5000;
    let interval;

    window.goToSlide = function(n) {
      current = n;
      track.style.transform = `translateX(-${(n - 1) * 100}%)`;
      updateDots();
    };

    window.nextSlide = function() {
      current = current < total ? current + 1 : 1;
      goToSlide(current);
    };

    window.prevSlide = function() {
      current = current > 1 ? current - 1 : total;
      goToSlide(current);
    };

    function updateDots() {
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-primary', i + 1 === current);
        dot.classList.toggle('bg-white/50', i + 1 !== current);
      });
    }

    if (autoplay) {
      interval = setInterval(nextSlide, speed);
      slideshow.addEventListener('mouseenter', () => clearInterval(interval));
      slideshow.addEventListener('mouseleave', () => interval = setInterval(nextSlide, speed));
    }
  })();
</script>

{% schema %}
{
  "name": "Slideshow",
  "class": "section-slideshow",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "height", "label": "Height", "min": 400, "max": 800, "default": 600, "step": 50 },
    { "type": "range", "id": "content_width", "label": "Content Width", "min": 400, "max": 800, "default": 600, "step": 50 },
    { "type": "checkbox", "id": "autoplay", "label": "Auto Play", "default": true },
    { "type": "range", "id": "speed", "label": "Speed (ms)", "min": 2000, "max": 10000, "default": 5000, "step": 500 },
    { "type": "checkbox", "id": "show_arrows", "label": "Show Arrows", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Show Dots", "default": true },
    { "type": "range", "id": "slide_count", "label": "Number of Slides", "min": 2, "max": 6, "default": 3, "step": 1 },
    { "type": "image_picker", "id": "slide_image_1", "label": "Slide 1 Image" },
    { "type": "text", "id": "slide_heading_1", "label": "Slide 1 Heading" },
    { "type": "text", "id": "slide_subheading_1", "label": "Slide 1 Subheading" },
    { "type": "text", "id": "slide_button_1", "label": "Slide 1 Button" },
    { "type": "url", "id": "slide_link_1", "label": "Slide 1 Link" },
    { "type": "image_picker", "id": "slide_image_2", "label": "Slide 2 Image" },
    { "type": "text", "id": "slide_heading_2", "label": "Slide 2 Heading" },
    { "type": "image_picker", "id": "slide_image_3", "label": "Slide 3 Image" },
    { "type": "text", "id": "slide_heading_3", "label": "Slide 3 Heading" }
  ],
  "presets": [{ "name": "Slideshow" }]
}
{% endschema %}