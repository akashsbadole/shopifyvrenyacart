{% comment %}Slideshow Section - LUXE Theme{% endcomment %}

<section class="relative w-full h-[600px] md:h-[700px] overflow-hidden" data-slideshow>
  <div class="slideshow__track flex transition-transform duration-500 h-full">
    {%- for i in (1..section.settings.slide_count) -%}
      {%- assign image_key = 'slide_image_' | append: i -%}
      {%- assign heading_key = 'slide_heading_' | append: i -%}
      {%- assign subheading_key = 'slide_subheading_' | append: i -%}
      {%- assign button_key = 'slide_button_' | append: i -%}
      {%- assign link_key = 'slide_link_' | append: i -%}
      
      <div class="slideshow__slide flex-shrink-0 w-full h-full" data-slide="{{ i }}">
        <div class="relative w-full h-full">
          {%- if section.settings[image_key] != blank -%}
            {{ section.settings[image_key] | image_url: width: 2000 | image_tag: class: 'absolute inset-0 w-full h-full object-cover', loading: 'eager' }}
          {%- else -%}
            <div class="absolute inset-0 flex items-center justify-center bg-zinc-100">
              <div class="text-center px-6">
                <span class="text-8xl font-black text-zinc-200">Slide {{ i }}</span>
              </div>
            </div>
          {%- endif -%}
          
          {%- if section.settings[heading_key] != blank -%}
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="text-center px-6 max-w-3xl">
              {%- if section.settings[subheading_key] != blank -%}
              <p class="text-sm font-bold text-white bg-[#0052FF] px-4 py-1 rounded mb-4 tracking-widest uppercase inline-block">{{ section.settings[subheading_key] }}</p>
              {%- endif -%}
              <h2 class="text-5xl md:text-7xl font-bold text-zinc-900 mb-6">{{ section.settings[heading_key] }}</h2>
              {%- if section.settings[button_key] != blank -%}
              <a href="{{ section.settings[link_key] }}" class="inline-block bg-[#0052FF] text-white font-bold text-sm px-8 py-4 rounded hover:bg-[#0038b6] transition-colors">
                {{ section.settings[button_key] }}
              </a>
              {%- endif -%}
            </div>
          </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.show_arrows -%}
  <button type="button" class="slideshow__arrow absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white flex items-center justify-center shadow-lg hover:bg-zinc-100" onclick="prevSlide()" aria-label="Previous">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
  </button>
  <button type="button" class="slideshow__arrow absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white flex items-center justify-center shadow-lg hover:bg-zinc-100" onclick="nextSlide()" aria-label="Next">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </button>
  {%- endif -%}

  {%- if section.settings.show_dots -%}
  <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2">
    {%- for i in (1..section.settings.slide_count) -%}
    <button type="button" class="slideshow__dot w-3 h-3 rounded-full {% if i == 1 %}bg-[#0052FF]{% else %}bg-white/50{% endif %}" onclick="goToSlide({{ i }})" aria-label="Go to slide {{ i }}"></button>
    {%- endfor -%}
  </div>
  {%- endif -%}
</section>

<script>
(function() {
  const slideshow = document.querySelector('[data-slideshow]');
  if (!slideshow) return;
  
  const track = slideshow.querySelector('.slideshow__track');
  const slides = slideshow.querySelectorAll('[data-slide]');
  const dots = slideshow.querySelectorAll('.slideshow__dot');
  let current = 1;
  const total = slides.length;
  let interval;

  window.goToSlide = function(n) {
    current = n;
    track.style.transform = 'translateX(-' + ((n - 1) * 100) + '%)';
    updateDots();
  };

  window.nextSlide = function() {
    current = current < total ? current + 1 : 1;
    goToSlide(current);
  };

  window.prevSlide = function() {
    current = current > 1 ? current - 1 : total;
    goToSlide(current);
  };

  function updateDots() {
    dots.forEach((dot, i) => {
      dot.classList.toggle('bg-[#0052FF]', i + 1 === current);
      dot.classList.toggle('bg-white/50', i + 1 !== current);
    });
  }

  {% if section.settings.autoplay %}
  interval = setInterval(nextSlide, {{ section.settings.speed | default: 5000 }});
  slideshow.addEventListener('mouseenter', () => clearInterval(interval));
  slideshow.addEventListener('mouseleave', () => interval = setInterval(nextSlide, {{ section.settings.speed | default: 5000 }}));
  {% endif %}
})();
</script>

{% schema %}
{
  "name": "Slideshow",
  "class": "section-slideshow",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "slide_count", "label": "Number of Slides", "min": 2, "max": 5, "default": 3, "step": 1 },
    { "type": "checkbox", "id": "autoplay", "label": "Auto Play", "default": true },
    { "type": "range", "id": "speed", "label": "Speed (ms)", "min": 3000, "max": 7000, "default": 5000, "step": 500 },
    { "type": "checkbox", "id": "show_arrows", "label": "Show Arrows", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Show Dots", "default": true },
    { "type": "image_picker", "id": "slide_image_1", "label": "Slide 1 Image" },
    { "type": "text", "id": "slide_heading_1", "label": "Slide 1 Heading", "default": "New Collection" },
    { "type": "text", "id": "slide_subheading_1", "label": "Slide 1 Subheading", "default": "Just Arrived" },
    { "type": "text", "id": "slide_button_1", "label": "Slide 1 Button", "default": "Shop Now" },
    { "type": "url", "id": "slide_link_1", "label": "Slide 1 Link" },
    { "type": "image_picker", "id": "slide_image_2", "label": "Slide 2 Image" },
    { "type": "text", "id": "slide_heading_2", "label": "Slide 2 Heading" },
    { "type": "image_picker", "id": "slide_image_3", "label": "Slide 3 Image" },
    { "type": "text", "id": "slide_heading_3", "label": "Slide 3 Heading" }
  ],
  "presets": [{ "name": "Slideshow" }]
}
{% endschema %}