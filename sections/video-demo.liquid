{% comment %}
  Video Demo Section - LUXE Theme
  Tech niche: Product video showcase
{% endcomment %}

<section class="video-demo py-16" style="padding: var(--section-spacing) 0;">
  <div class="container mx-auto px-6 text-center" style="max-width: var(--container-width);">
    {%- if section.settings.heading != blank -%}
      <h2 class="text-3xl font-bold mb-4">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="video-demo__wrapper relative max-w-4xl mx-auto rounded overflow-hidden" style="aspect-ratio: 16/9;">
      {%- if section.settings.video_url != blank -%}
        {%- if section.settings.video_url.type == 'youtube' -%}
          <iframe
            src="https://www.youtube.com/embed/{{ section.settings.video_url | split: 'v=' | last }}"
            class="absolute inset-0 w-full h-full"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        {%- elsif section.settings.video_url.type == 'vimeo' -%}
          <iframe
            src="https://player.vimeo.com/video/{{ section.settings.video_url | split: '/' | last }}"
            class="absolute inset-0 w-full h-full"
            frameborder="0"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
          ></iframe>
        {%- else -%}
          <video class="w-full h-full" controls poster="{{ section.settings.poster | image_url: width: 1200 }}">
            <source src="{{ section.settings.video_url }}" type="video/mp4">
          </video>
        {%- endif -%}
      {%- elsif section.settings.video_file != blank -%}
        <video class="w-full h-full" controls>
          {{ section.settings.video_file | video_tag: class: 'w-full h-full object-cover' }}
        </video>
      {%- else -%}
        <div class="w-full h-full flex items-center justify-center" style="background: var(--color-surface);">
          <div class="text-center">
            <svg class="w-16 h-16 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-primary);">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <p class="text-lg font-semibold">Product Demo Video</p>
            <p class="text-sm" style="color: var(--color-text-secondary);">Add your video URL above</p>
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.caption != blank -%}
      <p class="mt-4 text-sm" style="color: var(--color-text-secondary);">{{ section.settings.caption }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Video Demo",
  "class": "section-video",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See It In Action"
    },
    {
      "type": "video",
      "id": "video_file",
      "label": "Video File"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "YouTube/Vimeo URL",
      "info": "Paste YouTube or Vimeo URL"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Video Poster"
    },
    {
      "type": "textarea",
      "id": "caption",
      "label": "Caption"
    }
  ],
  "presets": [
    {
      "name": "Video Demo"
    }
  ]
}
{% endschema %}