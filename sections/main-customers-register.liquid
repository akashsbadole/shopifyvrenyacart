{% comment %}Customer Register Section - LUXE Theme{% endcomment %}

<section class="max-w-[1440px] mx-auto px-6 md:px-12 py-12">
  <div class="max-w-md mx-auto">
    <h1 class="text-4xl font-bold text-[var(--color-text-primary)] text-center mb-8">Create Account</h1>

    {% form 'create_customer' %}
      {% if form.errors %}
        <div class="bg-red-50 text-red-600 p-4 rounded mb-6">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="space-y-4">
        <div>
          <label for="first_name" class="block text-sm font-medium text-[var(--color-text-primary)] mb-2">First Name</label>
          <input 
            type="text" 
            id="first_name" 
            name="customer[first_name]" 
            class="w-full h-12 px-4 border border-[var(--color-border)] rounded bg-[var(--color-surface)] focus:outline-none focus:border-[var(--color-primary)]"
          >
        </div>

        <div>
          <label for="last_name" class="block text-sm font-medium text-[var(--color-text-primary)] mb-2">Last Name</label>
          <input 
            type="text" 
            id="last_name" 
            name="customer[last_name]" 
            class="w-full h-12 px-4 border border-[var(--color-border)] rounded bg-[var(--color-surface)] focus:outline-none focus:border-[var(--color-primary)]"
          >
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-[var(--color-text-primary)] mb-2">Email</label>
          <input 
            type="email" 
            id="email" 
            name="customer[email]" 
            required
            class="w-full h-12 px-4 border border-[var(--color-border)] rounded bg-[var(--color-surface)] focus:outline-none focus:border-[var(--color-primary)]"
          >
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-[var(--color-text-primary)] mb-2">Password</label>
          <input 
            type="password" 
            id="password" 
            name="customer[password]" 
            required
            class="w-full h-12 px-4 border border-[var(--color-border)] rounded bg-[var(--color-surface)] focus:outline-none focus:border-[var(--color-primary)]"
          >
        </div>

        <button 
          type="submit" 
          class="w-full h-12 bg-[var(--color-primary)] text-white font-bold rounded hover:opacity-90 transition-opacity"
        >
          Create Account
        </button>
      </div>

      <div class="mt-6 text-center">
        <a href="{{ routes.account_login_url }}" class="text-[var(--color-primary)] hover:opacity-70">Already have an account? Sign in</a>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Customer Register",
  "tag": "section",
  "class": "section-register",
  "settings": []
}
{% endschema %}