{% comment %}Bento Grid Section - LUXE Theme{% endcomment %}

<section class="py-[120px] px-6 md:px-12 max-w-[1440px] mx-auto">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-8 h-auto md:h-[600px]">
    <div class="md:col-span-8 bg-zinc-100 p-12 flex flex-col justify-between relative overflow-hidden group border border-zinc-200">
      <div class="absolute inset-0 w-full h-full z-0 opacity-20 group-hover:opacity-30 transition-opacity duration-700">
        {% if section.settings.image_1 %}
          {{ section.settings.image_1 | image_url: width: 800 | image_tag: class: 'w-full h-full object-cover mix-blend-luminosity grayscale' }}
        {% else %}
          <div class="w-full h-full bg-zinc-200"></div>
        {% endif %}
      </div>
      <div class="relative z-10 max-w-md">
        <span class="text-sm font-bold text-[#0052FF] uppercase tracking-widest mb-4 block">The Process</span>
        <h2 class="text-5xl font-bold text-zinc-900 mb-4 leading-tight">Engineered without compromise.</h2>
      </div>
      <div class="relative z-10 self-start">
        <a href="{{ section.settings.link_1 | default: routes.root_url }}" class="text-sm font-bold text-zinc-900 border-b-2 border-zinc-900 pb-1 hover:text-[#0052FF] hover:border-[#0052FF] transition-colors">Read Our Story</a>
      </div>
    </div>
    <div class="md:col-span-4 bg-[#0052FF] text-white p-12 flex flex-col justify-center border border-[#0052FF] relative overflow-hidden group">
      <div class="absolute top-0 right-0 p-6 opacity-20">
        <svg class="w-16 h-16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
      </div>
      <h3 class="text-2xl font-semibold mb-4">Lifetime Guarantee</h3>
      <p class="text-blue-100 mb-8">We believe in precision that lasts. Every product is backed by our rigorous quality standard.</p>
      <a href="{{ section.settings.link_2 | default: routes.root_url }}" class="text-sm font-bold text-white border-b border-white/50 pb-1 self-start hover:text-white hover:border-white transition-colors">Learn More</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bento Grid",
  "class": "section-bento",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image_1", "label": "Background Image" },
    { "type": "url", "id": "link_1", "label": "First Box Link" },
    { "type": "url", "id": "link_2", "label": "Second Box Link" }
  ],
  "presets": [{ "name": "Bento Grid" }]
}
{% endschema %}