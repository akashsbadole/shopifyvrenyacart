{% comment %}
  In-Menu Promo - vrenyaCart Theme
  Promotional banners inside navigation menu
{% endcomment %}

<div class="in-menu-promo p-4 rounded" style="background: {{ section.settings.bg_color }};">
  <div class="flex items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      {%- if section.settings.icon != blank -%}
      <span class="text-2xl">{{ section.settings.icon }}</span>
      {%- endif -%}
      <div>
        {%- if section.settings.title != blank -%}
          <p class="font-semibold" style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</p>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="text-sm" style="color: {{ section.settings.text_color }}; opacity: 0.8;">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
    </div>
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="text-sm font-semibold underline" style="color: {{ section.settings.link_color }};">
        {{ section.settings.link_text | default: 'Shop Now' }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "In-Menu Promo",
  "class": "section-in-menu-promo",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "icon", "label": "Icon (emoji)" },
    { "type": "text", "id": "title", "label": "Title", "default": "Free Shipping" },
    { "type": "text", "id": "text", "label": "Text", "default": "On orders over $50" },
    { "type": "text", "id": "link_text", "label": "Link Text" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0052FF" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "color", "id": "link_color", "label": "Link Color", "default": "#ffffff" }
  ],
  "presets": [{ "name": "In-Menu Promo" }]
}
{% endschema %}